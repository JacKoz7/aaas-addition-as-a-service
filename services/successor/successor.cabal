cabal-version: 3.0

-- SPDX-License-Identifier: MIT
-- Copyright (c) 2026 AaaS Contributors
--
-- Component:       successor
-- Module:          successor.cabal
-- Owning Team:     Arithmetic Excellence Center (AEC)
-- Classification:  INTERNAL
-- Purpose:         Cabal package of the successor service: the internal
--                  library of the generated gRPC messages, the library with
--                  all logic, the executable, the hspec test suite and the
--                  doctest suite of the documentation examples.
-- Related Docs:    services/successor/README.md, ADR-0016, ADR-0020, ADR-0033

name:          successor
version:       0.2.0
synopsis:      AaaS successor: computes n + 1 through the digit services and carry
license:       MIT
author:        AaaS Contributors
maintainer:    AaaS Contributors
category:      Arithmetic
build-type:    Simple

-- Warnings shared by every component; -Werror is added by the lint and
-- build stages through cabal.project (ADR-0016).
common warnings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists
    -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
    -Wmissing-signatures

common language
  default-language:   GHC2021
  default-extensions:
    DerivingStrategies
    LambdaCase
    OverloadedStrings

-- The messages of contracts/gen/haskell (proto-lens-protoc, ADR-0020),
-- copied to gen/ by the Dockerfile from the `contracts` build context.
-- Generated code is not edited, formatted or linted; its warnings are off.
library proto
  default-language: Haskell2010
  hs-source-dirs:   gen
  ghc-options:      -w
  exposed-modules:
    Proto.Aaas.Carry.V1.Carry
    Proto.Aaas.Carry.V1.Carry_Fields
    Proto.Aaas.Successor.V1.Successor
    Proto.Aaas.Successor.V1.Successor_Fields

  build-depends:
    , base                ^>=4.20
    , proto-lens-runtime  ^>=0.7

library
  import:          warnings, language
  hs-source-dirs:  src
  exposed-modules:
    Successor.Api
    Successor.CallLog
    Successor.Carry
    Successor.Config
    Successor.Core
    Successor.Digits
    Successor.Event
    Successor.Exceptions
    Successor.Grpc
    Successor.Identifiers
    Successor.Log
    Successor.Metrics
    Successor.Publisher
    Successor.Rpc
    Successor.Service
    Successor.Trace

  build-depends:
    , aeson               ^>=2.3
    , base                ^>=4.20
    , bytestring          ^>=0.12
    , containers          ^>=0.7
    , directory           ^>=1.3
    , filepath            ^>=1.5
    , grapesy             ^>=1.2
    , http-client         ^>=0.7
    , http-types          ^>=0.12
    , hw-kafka-client     ^>=5.3
    , lens-family         ^>=2.1
    , prometheus-client   ^>=1.1
    , proto-lens          ^>=0.7
    , random              ^>=1.2
    , scientific          ^>=0.3
    , stm                 ^>=2.5
    , successor:proto
    , text                ^>=2.1
    , time                ^>=1.12
    , wai                 ^>=3.2
    , warp                ^>=3.4

executable successor
  import:         warnings, language
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts "-with-rtsopts=-N2 -M40m"
  build-depends:
    , aeson
    , base
    , successor
    , text
    , unix       ^>=2.8
    , warp

test-suite spec
  import:         warnings, language
  type:           exitcode-stdio-1.0
  hs-source-dirs: tests
  main-is:        Spec.hs
  ghc-options:    -threaded
  build-depends:
    , aeson
    , base
    , bytestring
    , case-insensitive
    , containers
    , directory
    , filepath
    , grapesy
    , hspec        ^>=2.11
    , http-types
    , lens-family
    , network      ^>=3.2
    , proto-lens
    , successor
    , successor:proto
    , text
    , wai
    , wai-extra    ^>=3.1
    , warp
