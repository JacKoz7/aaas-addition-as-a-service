#
# Component:       digit-8
# Module:          .editorconfig
# Owning Team:     Arithmetic Excellence Center (AEC)
# Classification:  INTERNAL
# Purpose:         dfmt settings of the D sources (dfmt reads .editorconfig);
#                  the repository's .editorconfig is outside the Docker build
#                  context, so the general settings are repeated here.
# Related Docs:    services/digit-8/README.md, ADR-0030

[*.d]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
max_line_length = 100
dfmt_brace_style = allman
dfmt_soft_max_line_length = 80
