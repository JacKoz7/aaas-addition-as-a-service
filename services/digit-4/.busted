--- busted configuration: tests in tests/, modules from src/.
-- Owner: Arithmetic Excellence Center (AEC). Since: digit-4 0.1.0.
-- @script busted
return {
  default = {
    ROOT = { "tests" },
    pattern = "_spec",
    lpath = "src/?.lua",
    lua = "lua5.4",
    verbose = true,
  },
}
