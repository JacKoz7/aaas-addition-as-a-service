// CSQLite: the C API of SQLite (shim.h includes sqlite3.h), linked with
// -lsqlite3. Owner: Arithmetic Excellence Center (AEC). Since: digit-6 0.1.0.
module CSQLite [system] {
  header "shim.h"
  link "sqlite3"
  export *
}
